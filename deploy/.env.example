# ──────────────────────────────────────────────────────────────────────────
# Cliender Design Pro — deploy environment
# Copy to `.env` (gitignored) and fill in real values.
# ──────────────────────────────────────────────────────────────────────────

# Environment
ENVIRONMENT=dev

# CORS — JSON array of allowed origins
CORS_ORIGINS=["http://localhost:2002","http://127.0.0.1:2002"]

# Cognitive brain — Anthropic Claude (required)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096

# Creative muscle — KIE.ai image/video models (required)
KID_AI_API_KEY=
KID_AI_BASE_URL=https://api.kid.ai/v1

# LangGraph
CRITIC_MAX_RETRIES=2

# Analytics + storage — Supabase (optional, enables cost analytics + shared store)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=
# Daily cost alert limit in USD (0 = disabled)
ANALYTICS_DAILY_LIMIT_USD=10

# Optional shared API gate for the backend
CDPRO_API_KEY=
