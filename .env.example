# ──────────────────────────────────────────────────────────────────────────
# Cliender Design Pro — environment variables
#
# Copy this file to `.env` (and/or deploy/.env) and fill in real values.
# Never commit real secrets — `.env` is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# Runtime environment: dev | prod
ENVIRONMENT=dev

# Allowed CORS origins (JSON array). Add your frontend origin(s).
CORS_ORIGINS=["http://localhost:2002","http://127.0.0.1:2002"]

# ── Cognitive brain: Anthropic Claude (required) ──────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096

# ── Creative muscle: KIE.ai image/video models (required) ─────────────────
# Used for image and video generation (gpt-imagenes-2, nano-banana-*, seedance-2.0).
KID_AI_API_KEY=
KID_AI_BASE_URL=https://api.kid.ai/v1

# ── LangGraph orchestration ───────────────────────────────────────────────
CRITIC_MAX_RETRIES=2

# ── Supabase: auth, shared store + cost analytics (optional) ──────────────
# Public/anon key is used by the browser; service key by the backend only.
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=
# Daily cost alert limit in USD (0 = disabled)
ANALYTICS_DAILY_LIMIT_USD=10

# ── Optional shared API gate for the backend ──────────────────────────────
CDPRO_API_KEY=
