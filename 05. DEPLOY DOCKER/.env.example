# ──────────────────────────────────────────────────────────────────────────
# Atelier Swarm — variables de entorno
# Copia a `.env` (gitignored) y rellena las claves reales.
# ──────────────────────────────────────────────────────────────────────────

# Entorno
ENVIRONMENT=dev

# Cerebro cognitivo — SOLO Anthropic Claude (regla de oro)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096

# Músculo creativo — SOLO Kid.ai (lista cerrada de modelos en core/config.py)
KID_AI_API_KEY=
KID_AI_BASE_URL=https://api.kid.ai/v1

# Grafo LangGraph
CRITIC_MAX_RETRIES=2


# Analytics de costes API — Supabase (aislado, solo Design Pro)
SUPABASE_URL=https://opjwsdaphsulnpuvpout.supabase.co
SUPABASE_SERVICE_KEY=
# Límite de alerta diaria en USD (0 = desactivado)
ANALYTICS_DAILY_LIMIT_USD=10